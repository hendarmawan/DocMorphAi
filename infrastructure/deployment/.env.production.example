# Copy to .env next to compose.prod.yaml (install.sh generates it for you).
# Values containing "$" (the password hash) must stay in single quotes.

# Domain for automatic HTTPS, e.g. docmorph.example.com. Point its DNS A record at
# this server first. Use :80 to serve plain HTTP on the server's IP address.
DOCMORPH_SITE_ADDRESS=:80

# Password gate. Make the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
DOCMORPH_BASIC_AUTH_USER=admin
DOCMORPH_BASIC_AUTH_HASH='$2a$14$replace.me.with.a.real.bcrypt.hash'

POSTGRES_PASSWORD=change-me

# Image tag to run: latest (main), a commit SHA, or a release tag such as v0.1.0.
DOCMORPH_VERSION=latest
# DOCMORPH_IMAGE_PREFIX=ghcr.io/hendarmawan/docmorphai

# Documents are stored on the api_data volume by default. For S3, Cloudflare R2
# or another S3-compatible store set:
# DOCMORPH_STORAGE_BACKEND=s3
# DOCMORPH_S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# DOCMORPH_S3_BUCKET=docmorph
# DOCMORPH_S3_REGION=auto
# DOCMORPH_S3_ACCESS_KEY=
# DOCMORPH_S3_SECRET_KEY=

# AI design assistant: heuristic works offline; anthropic uses Claude.
DOCMORPH_AI_PROVIDER=heuristic
ANTHROPIC_API_KEY=
