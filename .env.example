# --- API ---
DOCMORPH_ENV=development
DOCMORPH_DATABASE_URL=sqlite:///./var/docmorph.db
# DOCMORPH_DATABASE_URL=postgresql+psycopg://docmorph:docmorph@localhost:5432/docmorph
DOCMORPH_REDIS_URL=
DOCMORPH_STORAGE_BACKEND=local          # local | s3
DOCMORPH_STORAGE_LOCAL_PATH=./var/storage
DOCMORPH_S3_ENDPOINT_URL=http://localhost:9000
DOCMORPH_S3_BUCKET=docmorph
DOCMORPH_S3_ACCESS_KEY=docmorph
DOCMORPH_S3_SECRET_KEY=docmorph-secret
DOCMORPH_MAX_UPLOAD_BYTES=26214400
DOCMORPH_CORS_ORIGINS=http://localhost:3000
DOCMORPH_AI_PROVIDER=heuristic          # heuristic | anthropic
ANTHROPIC_API_KEY=

# --- Web ---
DOCMORPH_API_URL=http://localhost:8000
